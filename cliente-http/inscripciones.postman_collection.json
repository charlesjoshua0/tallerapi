{
  "info": {
    "name": "API de Inscripciones - Paso 6",
    "description": "Secuencia del Paso 6. Reinicia la API antes de ejecutarla completa: los datos están en memoria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Inscribir e1 en IS2 (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/inscripciones",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "inscripciones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estudiante_id\": \"e1\",\n  \"curso_codigo\": \"IS2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Queda ACTIVA\", () => {",
              "    pm.expect(pm.response.json().estado).to.eql(\"ACTIVA\");",
              "});",
              "pm.collectionVariables.set(\"inscripcion_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
