    {
      "name": "6. Consultar la inscripción creada (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/inscripciones/{{inscripcion_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "inscripciones",
            "{{inscripcion_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Es la inscripción de la petición 1\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"inscripcion_id\")));",
              "});"
            ]
          }
        }
      ]
